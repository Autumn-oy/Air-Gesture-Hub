# ============================================================
#  云枢（Air Gesture Hub）—— 不要把这些提交进仓库
# ============================================================

# ---- ★ 签名与口令：一旦提交就等于把"应用身份"送人 ----
#      拿到它们的人可以签出既能通过 SignatureGuard 自检、
#      又能覆盖安装你 App 的包 —— 签名校验那层防护会直接归零。
keystore/
keystore.properties
*.jks
*.keystore

# ---- 构建产物（本机可重新生成）----
build/
app/build/
.gradle/
.kotlin/
local.properties
*.apk
*.aab

# ---- 归档的历史 APK：走 GitHub Releases 发布，不进 git 历史 ----
#      （二进制留在每个提交里会让 clone 越来越慢）
release/

# ---- 开发侧工程记录：不随仓库发布（文件保留在本地磁盘）----
#      docs/ 已从 git 历史里彻底移除（重写历史 + force push），
#      这里再留一道防线，防止以后手滑把它 add 回去。
docs/

# ---- IDE / 操作系统 ----
.idea/
*.iml
.DS_Store
Thumbs.db

# ---- Python 缓存（probe/ 里只有脚本）----
__pycache__/
*.pyc
